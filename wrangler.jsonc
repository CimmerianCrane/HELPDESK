{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cimmerian-crane-helpdesk",
  // Custom entry, not `.open-next/worker.js` — it adds the cron `scheduled()` handler that OpenNext's
  // generated worker does not provide. Everything else is delegated to it unchanged.
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-09-01",
  // Prisma's `pg` driver needs `node:net`/`node:tls`, and the app imports `node:crypto` throughout.
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  // Network-level pooling in front of Supabase. The Worker's Prisma client is created per request
  // (see src/lib/db.ts); Hyperdrive is what makes that affordable.
  // Create it once:  npx wrangler hyperdrive create cimmerian-crane --connection-string="<supabase pooler string>"
  // then paste the returned id here.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_ID"
    }
  ],

  // Replaces vercel.json "crons" — 01:00 UTC daily, the same schedule.
  "triggers": {
    "crons": ["0 1 * * *"]
  },

  "observability": {
    "enabled": true
  },

  // Non-secret configuration. Secrets (AUTH_SECRET, CRON_SECRET, DOCUMENT_SERVICE_SECRET, …) are set
  // with `wrangler secret put`, never here.
  "vars": {
    // The document-service URL is REQUIRED on the Worker: react-pdf cannot run on workerd, so a Worker
    // without this renders nothing. Point it at the deployed service (see document-service/).
    "DOCUMENT_SERVICE_URL": "https://REPLACE_WITH_DOCUMENT_SERVICE_HOST",
    "APP_BASE_URL": "https://cranedesk.app",
    "STORAGE_DRIVER": "supabase",
    "DEFAULT_TIMEZONE": "Asia/Singapore",
    "DEFAULT_CURRENCY": "SGD",
    "DEFAULT_GST_RATE": "0.09"
  }
}
