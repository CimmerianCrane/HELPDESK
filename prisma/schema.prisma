// Cimmerian Crane Services — data model.
// Designed for all four phases up front (brief §0.4) so later phases add migrations, not rewrites.
// Phase 1 implements UI/logic for a subset; the unused tables simply sit empty until their phase.
//
// Conventions:
//   - uuid(7) ids: time-sortable, and client-generatable, which offline sync depends on.
//   - Money Decimal(12,2); quantities Decimal(12,3) (parts are measured in metres/kg). Never Float.
//   - All timestamps UTC. Timezone/currency/GST are Settings rows, never constants.
//   - `*ById` fields are plain scalars (not relations) so User does not accumulate 20 back-relations.
//   - `deletedAt` = soft delete. Reports, certificates and audit logs are never hard-deleted.
//   - Line tables (quote/invoice/DO/PO/stocktake lines) reference Part by id scalar, not FK: they are
//     historical records that must survive a part being deprecated.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations run against the direct connection; the runtime uses the pooler. See .env.example.
  directUrl = env("DIRECT_URL")
}

