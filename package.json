{
  "name": "cimmerian-crane-helpdesk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "setup": "npm install && npm run db:migrate && npm run seed",
    "postinstall": "prisma generate",
    "dev": "next dev --webpack",
    "dev:lan": "tsx scripts/dev-lan.ts",
    "dev:stop": "tsx scripts/dev-stop.ts",
    "build": "next build --webpack",
    "start": "next start",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "seed": "prisma db seed",
    "admin:create": "tsx scripts/create-admin.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "perf": "node scripts/perf.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "verify:full": "npm run verify && npm run test:integration && npm run test:e2e"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^6.2.1",
    "@react-pdf/renderer": "^4.9.0",
    "@serwist/next": "^9.5.13",
    "dexie": "^4.4.7",
    "next": "^16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "serwist": "^9.5.13",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/web-push": "^3.6.4",
    "chrome-launcher": "^1.2.2",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.4.3",
    "lighthouse": "^13.5.0",
    "postcss": "^8.5.1",
    "prisma": "^6.2.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
