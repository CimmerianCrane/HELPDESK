# Copy to .env and fill in. .env is gitignored.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Supabase gives you several connection strings, and Prisma needs two of them:
#
#   DATABASE_URL  the TRANSACTION pooler (port 6543). Used by the app at runtime.
#                 Must include ?pgbouncer=true so Prisma does not use prepared
#                 statements, which the transaction pooler does not support.
#   DIRECT_URL    the SESSION pooler (port 5432). Used ONLY for migrations,
#                 because the transaction pooler cannot run DDL.
#
# Use the pooler for both, not `db.<ref>.supabase.co`: newer Supabase projects
# expose that direct hostname over IPv6 only, so it fails on IPv4-only networks.
#
# Supabase dashboard -> Connect -> "Transaction pooler" and "Session pooler".
# The username is `postgres.<project-ref>`, not `postgres`.
#
# Copy the region verbatim from the dashboard. Guessing it from where the company is based is the
# most common way to waste an hour: a wrong region fails with "Tenant or user not found", which
# reads like an authentication problem but is not.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Using the bundled local Postgres (`npm run db:up`) instead? Use these:
# DATABASE_URL="postgresql://cimmerian:cimmerian@localhost:5432/cimmerian"
# DIRECT_URL="postgresql://cimmerian:cimmerian@localhost:5432/cimmerian"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Locale defaults. These seed the Setting table on first run; after that the
# office team edits them in Admin, not here.
DEFAULT_TIMEZONE="Asia/Singapore"
DEFAULT_CURRENCY="SGD"
DEFAULT_GST_RATE="0.09"

# ---------------------------------------------------------------------------
# Adapters
# ---------------------------------------------------------------------------
# Local development writes files to ./storage and prints email to the console.
# Production on Vercel must use Supabase Storage — serverless functions have no
# durable disk. Get the URL and service-role key from the Supabase dashboard
# (Project Settings -> API). The bucket is private; files are served by signed URL.
STORAGE_DRIVER="disk"
STORAGE_DISK_PATH="./storage"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="cimmerian-files"

EMAIL_DRIVER="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="helpdesk@cimmeriancrane.example"

# P1 alerts also go out by SMS and WhatsApp (slice 36). Both default to `console`,
# which logs the message and records the row as sent. `twilio` and `meta` are the
# named production drivers and are not implemented yet: naming one falls back to
# console with a warning, so an alert is never silently lost. Numbers come from
# the user's `phone` field on /admin/users.
SMS_DRIVER="console"
WHATSAPP_DRIVER="console"

# Pushing issued invoices into Xero (slice 37). `none` keeps the CSV export as the
# only way money leaves the app. Xero uses a "custom connection": create one at
# https://developer.xero.com -> My Apps -> Custom connections, authorise it against
# the org, and copy the client id and secret. It is a client-credentials grant, so
# there is no refresh token to store. The org is whichever one authorised it.
ACCOUNTING_DRIVER="none"
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
# Override only to point at a mock. The driver appends /connections and
# /api.xro/2.0/Invoices to this base.
XERO_API_BASE="https://api.xero.com"
# The GST rate code on the org: `SR` is standard-rated in most regions; an AU org
# uses `OUTPUT2`. Check the org's tax rates in Xero before switching the driver on.
XERO_TAX_TYPE="SR"
# Optional: posted as each line's AccountCode. Leave blank to let the org default apply.
XERO_SALES_ACCOUNT_CODE=""

LOG_LEVEL="info"

# ---------------------------------------------------------------------------
# Scheduled jobs (Vercel Cron)
# ---------------------------------------------------------------------------
# Vercel sends `Authorization: Bearer <CRON_SECRET>` to the cron endpoints. Set the
# same value in Vercel -> Project -> Settings -> Environment Variables. Without it,
# cron requests are refused in production. Generate one the same way as AUTH_SECRET.
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Seed
# ---------------------------------------------------------------------------
# The password given to the demo accounts `npm run seed` creates. Leave it unset
# and they all get `cimmerian-dev-2026`, which is a password published in this
# repository — so the seed only creates those accounts when DATABASE_URL points
# at this machine. Against a hosted database (Supabase, for instance) it skips
# them and says so, unless you set SEED_DEMO_USERS=true to say you meant it.
SEED_PASSWORD=""
# Set this to seed the demo accounts into a database that is not on localhost.
# Fine for a hosted development project; never for the database real work lives in.
# SEED_DEMO_USERS="true"
