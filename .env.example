# Copy to .env and fill in. .env is gitignored.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Supabase gives you several connection strings, and Prisma needs two of them:
#
#   DATABASE_URL  the TRANSACTION pooler (port 6543). Used by the app at runtime.
#                 Must include ?pgbouncer=true so Prisma does not use prepared
#                 statements, which the transaction pooler does not support.
#   DIRECT_URL    the SESSION pooler (port 5432). Used ONLY for migrations,
#                 because the transaction pooler cannot run DDL.
#
# Use the pooler for both, not `db.<ref>.supabase.co`: newer Supabase projects
# expose that direct hostname over IPv6 only, so it fails on IPv4-only networks.
#
# Supabase dashboard -> Connect -> "Transaction pooler" and "Session pooler".
# The username is `postgres.<project-ref>`, not `postgres`.
#
# Copy the region verbatim from the dashboard. Guessing it from where the company is based is the
# most common way to waste an hour: a wrong region fails with "Tenant or user not found", which
# reads like an authentication problem but is not.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Using the bundled local Postgres (`npm run db:up`) instead? Use these:
# DATABASE_URL="postgresql://cimmerian:cimmerian@localhost:5432/cimmerian"
# DIRECT_URL="postgresql://cimmerian:cimmerian@localhost:5432/cimmerian"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Locale defaults. These seed the Setting table on first run; after that the
# office team edits them in Admin, not here.
DEFAULT_TIMEZONE="Asia/Singapore"
DEFAULT_CURRENCY="SGD"
DEFAULT_GST_RATE="0.09"

# ---------------------------------------------------------------------------
# Adapters (local dev defaults: write files to disk, print email to the console)
# ---------------------------------------------------------------------------
STORAGE_DRIVER="disk"
STORAGE_DISK_PATH="./storage"

EMAIL_DRIVER="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="helpdesk@cimmeriancrane.example"

LOG_LEVEL="info"
